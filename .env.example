# Agent identity (the Entra object/principal id of the Foundry agent to analyze)
ALP_PRINCIPAL_ID=00000000-0000-0000-0000-000000000000

# Display name and one-line role shown for the agent in the dashboard roster
ALP_AGENT_NAME=agent
ALP_AGENT_ROLE=AI agent

# Azure subscription containing the agent's role assignments
ALP_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Log Analytics workspace GUID backing the Foundry project's Application Insights
ALP_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# How many days of trace history to analyze
ALP_LOOKBACK_DAYS=30
